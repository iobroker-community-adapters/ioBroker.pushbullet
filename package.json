{
  "name": "iobroker.pushbullet",
  "version": "3.0.1",
  "description": "Pushbullet Adapter for ioBroker",
  "author": "Jens1809 <cpthans@gmail.com>",
  "contributors": [
    "mcm1957 <mcm57@gmx.at>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "maintainers": [
    {
      "name": "iobroker-community-adapters",
      "email": "mcm57@gmx.at"
    }
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.pushbullet",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "pushbullet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.pushbullet"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "pushbullet": "~3.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "tsx tasks.ts",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-compile": "tsx tasks.ts --2-compile",
    "3-copy": "tsx tasks.ts --3-copy",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha --require test/mocha.setup.js test/package --exit",
    "test:integration": "mocha --require test/mocha.setup.js test/integration --exit",
    "test": "npm run test:package",
    "npm": "npm i && cd src-admin && npm i",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.pushbullet/issues"
  },
  "readmeFilename": "README.md"
}
